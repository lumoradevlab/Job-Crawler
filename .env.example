# Copy to .env and fill in. .env is git-ignored and must never be committed.
# On a server this is /opt/jobcrawler/.env, read by the systemd unit and
# readable only by the service account.

# From @BotFather on Telegram. The multi-user bot (jobcrawler-serve) needs
# only the token: it addresses every subscriber by the chat id they arrived
# with. TELEGRAM_CHAT_ID is for the single-chat jobcrawler-bot, which sends
# to one chat read from here — `jobcrawler-bot --chat-id-help` explains how
# to find it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional. Free instantly at https://developer.adzuna.com/signup
# The only source here that carries real salary data.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional. Key emailed after review at https://jooble.org/api/about
# Not in the bot's default source list; add it with --source ... jooble
JOOBLE_KEY=

# Optional. Free instantly at https://developer.usajobs.gov/apirequest/
# USAJOBS_EMAIL must be the address the key was registered to.
USAJOBS_KEY=
USAJOBS_EMAIL=
